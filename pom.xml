<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- identificação do projeto -->
    <groupId>app</groupId>
    <artifactId>meuscontatos</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>MeusContatos</name>

    <properties>
        <!-- compila para Java 21 (funciona em JDK 21 ou superior) -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- acentos corretos nos arquivos-fonte -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- versão do JavaFX (o Maven baixa sozinho, com as bibliotecas nativas) -->
        <javafx.version>21.0.5</javafx.version>
    </properties>

    <dependencies>
        <!-- componentes visuais do JavaFX (Label, Button, TableView...) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- suporte a FXML (etapa 4C) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- driver JDBC do MySQL (só é necessário na hora de executar) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.4.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- JUnit 4 (os testes que você já escreveu usam org.junit.Test) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- plugin que roda o JavaFX já com o module-path certo, sem configuração manual -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- classe JavaFX executada pelo Run (F6); trocaremos pela tela da agenda na etapa 4B -->
                    <mainClass>app.HelloFX</mainClass>
                    <options>
                        <!-- silencia o aviso de método nativo restrito do JDK 24 ou superior -->
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
