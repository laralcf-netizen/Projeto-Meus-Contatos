<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <!-- faz o botão Run (F6) do NetBeans executar o JavaFX via plugin -->
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.openjfx:javafx-maven-plugin:0.0.8:run</goal>
        </goals>
    </action>
</actions>
