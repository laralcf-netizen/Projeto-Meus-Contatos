<?xml version="1.0" encoding="UTF-8"?>

<!-- imports: cada tipo usado na tela precisa ser importado, como no Java -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- raiz da tela: layout com topo, centro e rodapé; fx:controller liga este FXML à classe Java que cuida dos eventos -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.AgendaController" prefWidth="760.0" prefHeight="560.0">

    <!-- TOPO: o formulário de cadastro, em grade de linhas e colunas -->
    <top>
        <GridPane hgap="10.0" vgap="8.0">
            <!-- margem interna do formulário -->
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>

            <!-- linha 0: nome (fx:id é a etiqueta que o Controller usa para achar este campo) -->
            <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="campoNome" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <!-- linha 1: telefone -->
            <Label text="Telefone:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="campoTelefone" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- linha 2: e-mail -->
            <Label text="E-mail:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="campoEmail" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <!-- linha 3: caixa "Contato comercial" -->
            <CheckBox fx:id="checkComercial" text="Contato comercial" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <!-- linha 4: empresa (o Controller liga a habilitação deste campo à caixa acima) -->
            <Label text="Empresa:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="campoEmpresa" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <!-- linha 5: botões; onAction="#nome" chama o método de mesmo nome no Controller -->
            <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <Button text="Salvar" onAction="#salvar"/>
                <Button text="Limpar" onAction="#limparFormulario"/>
            </HBox>
        </GridPane>
    </top>

    <!-- CENTRO: barra de busca em cima e tabela embaixo -->
    <center>
        <VBox spacing="8.0">
            <!-- margem lateral -->
            <padding>
                <Insets left="12.0" right="12.0"/>
            </padding>

            <!-- barra de busca e botões de ação -->
            <HBox spacing="10.0">
                <TextField fx:id="campoBusca" promptText="Buscar por nome"/>
                <Button text="Buscar" onAction="#buscar"/>
                <Button text="Mostrar todos" onAction="#carregarContatos"/>
                <Button text="Remover selecionado" onAction="#remover"/>
            </HBox>

            <!-- tabela de contatos; as colunas ganham fx:id para o Controller configurar o que mostrar -->
            <TableView fx:id="tabela" prefHeight="320.0">
                <columns>
                    <TableColumn fx:id="colNome" prefWidth="180.0" text="Nome"/>
                    <TableColumn fx:id="colTelefone" prefWidth="140.0" text="Telefone"/>
                    <TableColumn fx:id="colEmail" prefWidth="200.0" text="E-mail"/>
                    <TableColumn fx:id="colEmpresa" prefWidth="180.0" text="Empresa"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- RODAPÉ: mensagem de status -->
    <bottom>
        <Label fx:id="status" text="Pronto.">
            <BorderPane.margin>
                <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
